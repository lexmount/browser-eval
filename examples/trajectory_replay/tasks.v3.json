{
  "schema": "lex_browser_use_tasks/2",
  "tasks": [
    {
      "id": "hacker-news-story-context",
      "title": "Read the top Hacker News story with its score and metadata",
      "tags": ["public", "simple", "dynamic-list"],
      "tool_calls": [
        {"action": "navigate", "url": "https://news.ycombinator.com/", "save_as": "page"},
        {"action": "get_text", "selector": ".athing .titleline > a", "save_as": "top_story"},
        {"action": "get_text", "selector": ".athing + tr .score", "save_as": "score"},
        {"action": "snapshot", "selector": ".athing + tr .subtext", "save_as": "metadata", "max_chars": 2000}
      ],
      "assertions": [
        {"output": "top_story", "min_chars": 5},
        {"output": "score", "contains": "point"},
        {"output": "metadata", "contains": "ago"}
      ]
    },
    {
      "id": "pypi-requests-release-profile",
      "title": "Inspect the current requests release and release-history section",
      "tags": ["public", "simple", "package-index"],
      "tool_calls": [
        {"action": "navigate", "url": "https://pypi.org/project/requests/", "save_as": "page"},
        {"action": "get_text", "selector": "h1", "save_as": "package_version"},
        {"action": "snapshot", "selector": "main", "save_as": "summary", "max_chars": 5000},
        {"action": "navigate", "url": "https://pypi.org/project/requests/#history", "save_as": "history_page", "max_chars": 3000},
        {"action": "snapshot", "selector": "main", "save_as": "history", "max_chars": 5000}
      ],
      "assertions": [
        {"output": "package_version", "contains": "requests"},
        {"output": "summary", "contains": "HTTP"},
        {"output": "history", "contains": "Release history"}
      ]
    },
    {
      "id": "arxiv-transformer-paper-profile",
      "title": "Inspect a paper's title, authors, abstract, and submission history",
      "tags": ["public", "medium", "research-paper", "long-text"],
      "tool_calls": [
        {"action": "navigate", "url": "https://arxiv.org/abs/1706.03762", "save_as": "page"},
        {"action": "get_text", "selector": "h1.title", "save_as": "title"},
        {"action": "get_text", "selector": ".authors", "save_as": "authors"},
        {"action": "get_text", "selector": "blockquote.abstract", "save_as": "abstract", "max_chars": 5000},
        {"action": "scroll", "direction": "down", "amount": 1000},
        {"action": "snapshot", "selector": ".metatable", "save_as": "metadata", "max_chars": 3000},
        {"action": "get_text", "selector": ".submission-history", "save_as": "history", "max_chars": 3000}
      ],
      "assertions": [
        {"output": "title", "contains": "Attention Is All You Need"},
        {"output": "authors", "contains": "Vaswani"},
        {"output": "abstract", "contains": "Transformer"},
        {"output": "history", "contains": "Submission history"}
      ]
    },
    {
      "id": "github-moli-readme-to-issues",
      "title": "Inspect Moli's README, open Issues, and restore navigation history",
      "tags": ["public", "medium", "repository", "click", "history"],
      "tool_calls": [
        {"action": "navigate", "url": "https://github.com/lexmount/moli", "save_as": "repository", "timeout_ms": 30000},
        {"action": "get_text", "selector": "article.markdown-body", "save_as": "readme", "max_chars": 16000},
        {"action": "navigate", "url": "https://github.com/lexmount/moli/issues", "save_as": "issues_page", "timeout_ms": 30000, "max_chars": 5000},
        {"action": "snapshot", "selector": "main", "save_as": "issues", "max_chars": 6000},
        {"action": "back"},
        {"action": "get_text", "selector": "article.markdown-body", "save_as": "restored_readme", "max_chars": 5000},
        {"action": "forward"},
        {"action": "snapshot", "selector": "main", "save_as": "restored_issues", "max_chars": 3000}
      ],
      "assertions": [
        {"output": "readme", "contains": "Moli"},
        {"output": "issues", "contains": "Issues"},
        {"output": "restored_readme", "contains": "Moli"},
        {"output": "restored_issues", "contains": "Issues"}
      ]
    },
    {
      "id": "mdn-fetch-guide-history",
      "title": "Follow MDN Fetch documentation and verify back/forward restoration",
      "tags": ["public", "medium", "documentation", "click", "history"],
      "tool_calls": [
        {"action": "navigate", "url": "https://developer.mozilla.org/en-US/docs/Web/API/Fetch_API", "save_as": "api_page"},
        {"action": "get_text", "selector": "h1", "save_as": "api_heading"},
        {"action": "click", "selector": "main a[href*='/Using_Fetch']", "timeout_ms": 20000},
        {"action": "get_text", "selector": "h1", "save_as": "guide_heading"},
        {"action": "snapshot", "selector": "main", "save_as": "guide_body", "max_chars": 6000},
        {"action": "back"},
        {"action": "get_text", "selector": "h1", "save_as": "back_heading"},
        {"action": "forward"},
        {"action": "get_text", "selector": "h1", "save_as": "forward_heading"}
      ],
      "assertions": [
        {"output": "api_heading", "contains": "Fetch API"},
        {"output": "guide_heading", "contains": "Using the Fetch API"},
        {"output": "back_heading", "contains": "Fetch API"},
        {"output": "forward_heading", "contains": "Using the Fetch API"}
      ]
    },
    {
      "id": "python-tutorial-two-chapters-history",
      "title": "Traverse two Python tutorial chapters and restore both history states",
      "tags": ["public", "medium", "documentation", "multi-page", "history"],
      "tool_calls": [
        {"action": "navigate", "url": "https://docs.python.org/3/tutorial/index.html", "save_as": "tutorial"},
        {"action": "get_text", "selector": "h1", "save_as": "tutorial_heading"},
        {"action": "click", "selector": "li.toctree-l1 a[href='appetite.html']"},
        {"action": "snapshot", "selector": "div.body[role='main']", "save_as": "appetite", "max_chars": 5000},
        {"action": "navigate", "url": "https://docs.python.org/3/tutorial/interpreter.html", "save_as": "interpreter_page", "max_chars": 3000},
        {"action": "get_text", "selector": "h1", "save_as": "interpreter_heading"},
        {"action": "back"},
        {"action": "get_text", "selector": "h1", "save_as": "restored_appetite"},
        {"action": "back"},
        {"action": "get_text", "selector": "h1", "save_as": "restored_tutorial"}
      ],
      "assertions": [
        {"output": "tutorial_heading", "contains": "Python Tutorial"},
        {"output": "appetite", "contains": "Whetting Your Appetite"},
        {"output": "interpreter_heading", "contains": "Using the Python Interpreter"},
        {"output": "restored_appetite", "contains": "Whetting Your Appetite"},
        {"output": "restored_tutorial", "contains": "Python Tutorial"}
      ]
    },
    {
      "id": "rfc9110-multi-section-history",
      "title": "Inspect multiple RFC 9110 sections and recover anchor history",
      "tags": ["public", "complex", "standard", "anchor", "long-document", "history"],
      "tool_calls": [
        {"action": "navigate", "url": "https://www.rfc-editor.org/rfc/rfc9110.html", "save_as": "rfc", "max_chars": 4000},
        {"action": "get_text", "selector": "h1", "save_as": "title"},
        {"action": "navigate", "url": "https://www.rfc-editor.org/rfc/rfc9110.html#name-introduction", "save_as": "intro_page", "max_chars": 2500},
        {"action": "get_text", "selector": "#section-1", "save_as": "introduction", "max_chars": 5000},
        {"action": "scroll", "direction": "down", "amount": 1400},
        {"action": "snapshot", "selector": "#section-2", "save_as": "conformance", "max_chars": 5000},
        {"action": "navigate", "url": "https://www.rfc-editor.org/rfc/rfc9110.html#name-terminology-and-core-concep", "save_as": "terminology_page", "max_chars": 2500},
        {"action": "get_text", "selector": "#section-3", "save_as": "terminology", "max_chars": 6000},
        {"action": "back"},
        {"action": "get_text", "selector": "#section-1", "save_as": "restored_intro", "max_chars": 2500},
        {"action": "forward"},
        {"action": "get_text", "selector": "#section-3", "save_as": "restored_terminology", "max_chars": 2500}
      ],
      "assertions": [
        {"output": "title", "contains": "RFC 9110"},
        {"output": "introduction", "contains": "Introduction"},
        {"output": "conformance", "contains": "Conformance"},
        {"output": "terminology", "contains": "Terminology"},
        {"output": "restored_terminology", "contains": "Terminology"}
      ]
    },
    {
      "id": "quotes-three-page-history",
      "title": "Traverse three quote pages and verify two-level history restoration",
      "tags": ["public", "complex", "pagination", "multi-page", "history"],
      "tool_calls": [
        {"action": "navigate", "url": "https://quotes.toscrape.com/", "save_as": "page_one"},
        {"action": "get_text", "selector": ".quote:first-of-type .text", "save_as": "quote_one"},
        {"action": "click", "selector": ".next a"},
        {"action": "snapshot", "selector": ".container", "save_as": "page_two", "max_chars": 5000},
        {"action": "click", "selector": ".next a"},
        {"action": "snapshot", "selector": ".container", "save_as": "page_three", "max_chars": 5000},
        {"action": "back"},
        {"action": "get_text", "selector": ".quote:first-of-type .text", "save_as": "restored_two"},
        {"action": "back"},
        {"action": "get_text", "selector": ".quote:first-of-type .text", "save_as": "restored_one"},
        {"action": "forward"},
        {"action": "snapshot", "selector": ".container", "save_as": "forward_two", "max_chars": 3000}
      ],
      "assertions": [
        {"output": "quote_one", "min_chars": 10},
        {"output": "page_two", "contains": "This life is what you make it"},
        {"output": "page_three", "contains": "I love you without knowing"},
        {"output": "restored_one", "contains": "world"},
        {"output": "forward_two", "contains": "This life is what you make it"}
      ]
    },
    {
      "id": "httpbin-form-resubmission",
      "title": "Submit a multi-field HTTPBin form, go back, edit, and resubmit",
      "tags": ["public", "complex", "form", "multi-field", "resubmission"],
      "tool_calls": [
        {"action": "navigate", "url": "https://httpbin.org/forms/post", "save_as": "form"},
        {"action": "fill", "selector": "input[name='custname']", "text": "Lexmount Browser Eval"},
        {"action": "fill", "selector": "textarea[name='comments']", "text": "First provider submission"},
        {"action": "fill", "selector": "input[name='delivery']", "text": "18:00"},
        {"action": "click", "selector": "label:has(input[name='size'][value='medium'])"},
        {"action": "click", "selector": "label:has(input[name='topping'][value='cheese'])"},
        {"action": "click", "selector": "button"},
        {"action": "snapshot", "save_as": "first_submission", "max_chars": 5000},
        {"action": "back"},
        {"action": "fill", "selector": "textarea[name='comments']", "text": "Revised provider submission"},
        {"action": "click", "selector": "button"},
        {"action": "snapshot", "save_as": "second_submission", "max_chars": 5000}
      ],
      "assertions": [
        {"output": "first_submission", "contains": "First provider submission"},
        {"output": "first_submission", "contains": "medium"},
        {"output": "second_submission", "contains": "Revised provider submission"}
      ]
    },
    {
      "id": "books-mystery-category-traversal",
      "title": "Browse a category, inspect a book, paginate, and inspect another book",
      "tags": ["public", "complex", "catalogue", "pagination", "detail-page", "history"],
      "tool_calls": [
        {"action": "navigate", "url": "https://books.toscrape.com/", "save_as": "catalogue"},
        {"action": "click", "selector": "a[href='catalogue/category/books/mystery_3/index.html']"},
        {"action": "snapshot", "selector": "ol.row", "save_as": "mystery_one", "max_chars": 6000},
        {"action": "click", "selector": "article.product_pod h3 a"},
        {"action": "get_text", "selector": ".product_main h1", "save_as": "first_book"},
        {"action": "get_text", "selector": ".product_main .price_color", "save_as": "first_price"},
        {"action": "snapshot", "selector": ".table-striped", "save_as": "first_details", "max_chars": 4000},
        {"action": "back"},
        {"action": "click", "selector": ".next a"},
        {"action": "snapshot", "selector": "ol.row", "save_as": "mystery_two", "max_chars": 6000},
        {"action": "click", "selector": "article.product_pod h3 a"},
        {"action": "get_text", "selector": ".product_main h1", "save_as": "second_book"},
        {"action": "back"}
      ],
      "assertions": [
        {"output": "mystery_one", "contains": "Sharp Objects"},
        {"output": "first_book", "min_chars": 3},
        {"output": "first_price", "contains": "£"},
        {"output": "first_details", "contains": "UPC"},
        {"output": "mystery_two", "contains": "The Mysterious Affair"},
        {"output": "second_book", "min_chars": 3}
      ]
    }
  ]
}
