{
  "schema": "lex_browser_use_tasks/1",
  "tasks": [
    {
      "id": "example-heading",
      "title": "Read the Example Domain heading",
      "tags": ["public", "static", "extract"],
      "steps": [
        {"action": "navigate", "url": "https://example.com/"},
        {"action": "extract", "selector": "h1", "save_as": "heading"}
      ],
      "assertions": [{"output": "heading", "contains": "Example Domain"}]
    },
    {
      "id": "hacker-news-top-story",
      "title": "Read Hacker News top story",
      "tags": ["public", "list", "extract"],
      "steps": [
        {"action": "navigate", "url": "https://news.ycombinator.com/"},
        {"action": "wait", "selector": ".athing .titleline > a"},
        {"action": "extract", "selector": ".athing .titleline > a", "save_as": "title"}
      ],
      "assertions": [{"output": "title", "min_chars": 5}]
    },
    {
      "id": "pypi-requests-version",
      "title": "Read the current PyPI requests version",
      "tags": ["public", "package", "extract"],
      "steps": [
        {"action": "navigate", "url": "https://pypi.org/project/requests/"},
        {"action": "wait", "selector": "h1"},
        {"action": "extract", "selector": "h1", "save_as": "package"}
      ],
      "assertions": [{"output": "package", "contains": "requests"}]
    },
    {
      "id": "arxiv-transformer-abstract",
      "title": "Read the Transformer paper abstract",
      "tags": ["public", "paper", "extract"],
      "steps": [
        {"action": "navigate", "url": "https://arxiv.org/abs/1706.03762"},
        {"action": "wait", "selector": "blockquote.abstract"},
        {"action": "extract", "selector": "blockquote.abstract", "save_as": "abstract"}
      ],
      "assertions": [
        {"output": "abstract", "contains": "Transformer"},
        {"output": "abstract", "min_chars": 300}
      ]
    },
    {
      "id": "wikipedia-python-overview",
      "title": "Inspect and scroll the Python Wikipedia article",
      "tags": ["public", "encyclopedia", "scroll"],
      "steps": [
        {"action": "navigate", "url": "https://en.wikipedia.org/wiki/Python_(programming_language)"},
        {"action": "wait", "selector": "h1"},
        {"action": "extract", "selector": "h1", "save_as": "heading"},
        {"action": "extract", "selector": "#mw-content-text", "save_as": "article", "max_chars": 5000},
        {"action": "scroll", "pixels": 900},
        {"action": "snapshot", "save_as": "viewport", "max_chars": 5000}
      ],
      "assertions": [
        {"output": "heading", "contains": "Python"},
        {"output": "article", "contains": "programming language"}
      ]
    },
    {
      "id": "github-moli-readme",
      "title": "Open the fixed Moli GitHub repository and inspect its README",
      "tags": ["public", "dynamic", "scroll", "repository"],
      "steps": [
        {"action": "navigate", "url": "https://github.com/lexmount/moli"},
        {"action": "wait", "selector": "article.markdown-body", "timeout_ms": 20000},
        {"action": "extract", "selector": "article.markdown-body h1", "save_as": "heading"},
        {"action": "extract", "selector": "article.markdown-body", "save_as": "readme", "max_chars": 40000},
        {"action": "scroll", "pixels": 1200},
        {"action": "snapshot", "save_as": "scrolled", "max_chars": 5000}
      ],
      "assertions": [
        {"output": "heading", "contains": "Moli"},
        {"output": "readme", "min_chars": 500}
      ]
    },
    {
      "id": "mdn-fetch-guide",
      "title": "Follow MDN Fetch API documentation into Using Fetch",
      "tags": ["public", "documentation", "click", "navigation"],
      "steps": [
        {"action": "navigate", "url": "https://developer.mozilla.org/en-US/docs/Web/API/Fetch_API"},
        {"action": "wait", "selector": "h1"},
        {"action": "extract", "selector": "h1", "save_as": "api_heading"},
        {"action": "extract", "selector": "main", "save_as": "api_body", "max_chars": 5000},
        {"action": "click", "selector": "main a[href*='/Using_Fetch']"},
        {"action": "wait", "selector": "h1"},
        {"action": "extract", "selector": "h1", "save_as": "guide_heading"},
        {"action": "extract", "selector": "main", "save_as": "guide_body", "max_chars": 5000}
      ],
      "assertions": [
        {"output": "api_heading", "contains": "Fetch API"},
        {"output": "guide_heading", "contains": "Using"}
      ]
    },
    {
      "id": "python-tutorial-navigation",
      "title": "Navigate Python tutorial chapters and history",
      "tags": ["public", "documentation", "multi-page", "history"],
      "steps": [
        {"action": "navigate", "url": "https://docs.python.org/3/tutorial/index.html"},
        {"action": "wait", "selector": "h1"},
        {"action": "extract", "selector": "h1", "save_as": "tutorial_heading"},
        {"action": "click", "selector": "li.toctree-l1 a[href='appetite.html']", "timeout_ms": 10000},
        {"action": "wait", "selector": "h1"},
        {"action": "extract", "selector": "h1", "save_as": "chapter_heading"},
        {"action": "extract", "selector": "div.body[role='main']", "save_as": "chapter_body", "max_chars": 5000},
        {"action": "back"},
        {"action": "wait", "selector": "h1"},
        {"action": "forward"},
        {"action": "extract", "selector": "h1", "save_as": "forward_heading"}
      ],
      "assertions": [
        {"output": "tutorial_heading", "contains": "Python Tutorial"},
        {"output": "chapter_body", "min_chars": 500}
      ]
    },
    {
      "id": "rfc9110-section-navigation",
      "title": "Inspect RFC 9110 and navigate to a section",
      "tags": ["public", "standard", "anchor", "history"],
      "steps": [
        {"action": "navigate", "url": "https://www.rfc-editor.org/rfc/rfc9110.html"},
        {"action": "wait", "selector": "h1"},
        {"action": "extract", "selector": "h1", "save_as": "title"},
        {"action": "extract", "selector": "body", "save_as": "overview", "max_chars": 5000},
        {"action": "click", "selector": "a.section-name.selfRef[href='#name-introduction']", "timeout_ms": 10000},
        {"action": "wait", "selector": "#section-1"},
        {"action": "extract", "selector": "#section-1", "save_as": "introduction", "max_chars": 5000},
        {"action": "scroll", "pixels": 1000},
        {"action": "snapshot", "save_as": "scrolled", "max_chars": 5000},
        {"action": "back"},
        {"action": "wait", "selector": "h1"},
        {"action": "forward"},
        {"action": "extract", "selector": "#section-1", "save_as": "restored", "max_chars": 2000}
      ],
      "assertions": [
        {"output": "title", "contains": "RFC 9110"},
        {"output": "introduction", "min_chars": 300}
      ]
    },
    {
      "id": "public-source-research-chain",
      "title": "Collect Python facts across four public sources",
      "tags": ["public", "multi-site", "research", "long"],
      "steps": [
        {"action": "navigate", "url": "https://en.wikipedia.org/wiki/Python_(programming_language)"},
        {"action": "wait", "selector": "h1"},
        {"action": "extract", "selector": "h1", "save_as": "wiki_heading"},
        {"action": "extract", "selector": "#mw-content-text", "save_as": "wiki_body", "max_chars": 5000},
        {"action": "navigate", "url": "https://pypi.org/project/requests/"},
        {"action": "wait", "selector": "h1"},
        {"action": "extract", "selector": "h1", "save_as": "pypi_heading"},
        {"action": "navigate", "url": "https://docs.python.org/3/tutorial/index.html"},
        {"action": "wait", "selector": "h1"},
        {"action": "extract", "selector": "h1", "save_as": "docs_heading"},
        {"action": "extract", "selector": "body", "save_as": "docs_body", "max_chars": 5000},
        {"action": "navigate", "url": "https://github.com/python/cpython"},
        {"action": "wait", "selector": "article.markdown-body", "timeout_ms": 20000},
        {"action": "extract", "selector": "h1", "save_as": "github_heading"},
        {"action": "extract", "selector": "article.markdown-body", "save_as": "github_readme", "max_chars": 10000},
        {"action": "snapshot", "save_as": "final_page", "max_chars": 5000}
      ],
      "assertions": [
        {"output": "wiki_heading", "contains": "Python"},
        {"output": "pypi_heading", "contains": "requests"},
        {"output": "docs_heading", "contains": "Python Tutorial"},
        {"output": "github_readme", "min_chars": 500}
      ]
    }
  ]
}
