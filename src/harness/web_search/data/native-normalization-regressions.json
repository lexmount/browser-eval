{
  "schema": "web-search-normalization-regressions/1",
  "regressions": [
    {
      "id": "relative-serp-links",
      "controls": [
        {
          "id": "relative",
          "method": {
            "adapter": "brightdata"
          },
          "protocol": {
            "top_k": 5,
            "normalize_top_k": true,
            "result_url_resolution": "request-url/1"
          },
          "request": {
            "url": "https://www.google.com/search?q=synthetic"
          },
          "case": {
            "family": "web",
            "anchors": [
              "https://www.google.com/goto?url=synthetic"
            ]
          },
          "payload": {
            "organic": [
              {
                "link": "/goto?url=synthetic",
                "title": "Synthetic result"
              }
            ]
          },
          "error": false,
          "expected_urls": [
            "https://www.google.com/goto?url=synthetic"
          ],
          "expected_metrics": {
            "anchor_hit_5": 1,
            "reciprocal_rank": 1
          }
        },
        {
          "id": "absolute",
          "method": {
            "adapter": "brightdata"
