# Local implementation checkout
COWAGENT_REPO=
COWAGENT_BENCHMARK_WORKSPACE=~/.webstone/runs/cowagent-workspace
OPENCLAW_REPO=
# OpenClaw is a measured method; DeepSeek Harness shares this pinned Node runtime.
OPENCLAW_NODE=~/.webstone/toolchains/openclaw-node/node_modules/node/bin/node
OPENCLAW_PNPM=~/.webstone/toolchains/openclaw-node/node_modules/.bin/pnpm
DEEPSEEK_HARNESS_REPO=
# DeepSeek API (Fetch and Search): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

OSS_PYTHON=.venv/bin/python
# Official Moli CLIs; each measured release binary is version- and SHA-256-gated.
# Use an executable path or a command on PATH. No API key is needed.
MOLI_BINARY=moli
# Optional compiled Darwin resolver for explicitly frozen public_doh runs.
MOLI_NATIVE_DNS_LIBRARY=
MOLI_PR643_BINARY=
# Optional release/candidate comparison slots. Pin identity before calls.
MOLI_RELEASE_BINARY=
MOLI_RELEASE_REPORTED_VERSION=
MOLI_RELEASE_BINARY_SHA256=
MOLI_CANDIDATE_BINARY=
MOLI_CANDIDATE_REPORTED_VERSION=
MOLI_CANDIDATE_BINARY_SHA256=
MOLI_1_1_11_BINARY=moli-1.1.11
MOLI_1_1_7_BINARY=moli-1.1.7
MOLI_1_0_6_BINARY=moli-1.0.6
MOLI_1_1_3_BINARY=moli-1.1.3
LIGHTPANDA_BINARY=lightpanda
OBSCURA_BINARY=obscura
# Optional for the local quickstart, which can use Playwright's installed browser.
# Formal cohorts must set the exact executable and bind its identity in their config.
CHROMIUM_BINARY=
# Cloudflare Browser Run constructs the account-scoped Kitesurf CDP endpoint
# from these values. Do not persist an Authorization header or token in evidence.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Browser Trajectory Replay diagnostics and autonomous Browser Use evaluation
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# WebArena routing, deployment and gateway variables share one rule: an exported
# variable wins, then this file (or the file given to the replay runner's
# --credential-env-file). Importing the code reads nothing; a value is read when needed.
# Self-hosted WebArena site accounts come only from this file, so a run and the redaction
# of its public output use the same value. Runtime JSON stores these variable names, not
# the local values. Runs that log in to the sites, Browser Use public report redaction, and
# public WebArena report exporting, packaging and publishing stop with an error while a needed
# value is empty; offline tools do not need them. These are the default accounts of the self-hosted
# WebArena images, listed as ACCOUNTS in https://github.com/web-arena-x/webarena/blob/dce04686a56253aefba7b18a4fa0937cf1dc987b/browser_env/env_config.py
WEBARENA_SHOPPING_ADMIN_USERNAME=
WEBARENA_SHOPPING_ADMIN_PASSWORD=
WEBARENA_SHOPPING_USERNAME=
WEBARENA_SHOPPING_PASSWORD=
WEBARENA_GITLAB_USERNAME=
WEBARENA_GITLAB_PASSWORD=
WEBARENA_REDDIT_USERNAME=
WEBARENA_REDDIT_PASSWORD=

# Artifact Site publishing never reads this file. Export ARTIFACT_SITE_TOKEN explicitly
# or save a token at ~/.config/artifact-site/tokens/<target-host>.
# Optional share links shown by scripts/report_template.py; each must carry the
# example_version registered in configs/report-templates.json.
WEBFETCH_REPORT_EXAMPLE_URL=
TRAJECTORY_REPLAY_REPORT_EXAMPLE_URL=
BROWSER_USE_REPORT_EXAMPLE_URL=

# Local report default, read automatically; exported environment overrides this.
# Agents pass --language from the conversation language unless the user specifies it.
# The code fallback is English when this variable is absent.
WEBSTONE_REPORT_LANGUAGE=

# Core benchmark
LEXMOUNT_API_KEY=
LEXMOUNT_PROJECT_ID=
LEXMOUNT_CN_API_KEY=
LEXMOUNT_CN_PROJECT_ID=
FIRECRAWL_API_KEY=

# Known-URL extraction candidates
TAVILY_API_KEY=
EXA_API_KEY=
BROWSERBASE_API_KEY=
BROWSER_USE_API_KEY=
# Independent SERP comparison: https://serper.dev/ and https://brightdata.com/
SERPER_API_KEY=
BRIGHTDATA_API_KEY=
# The Bright Data SERP zone name is an explicit profile output option.

# Query-to-search-results and model-bound retrieval
QIANFAN_API_KEY=
# Yuanbao Search service API KEY (not a Tencent Cloud SecretId/SecretKey pair).
# Activate and create a key: https://console.cloud.tencent.com/wsa
# Setup: https://cloud.tencent.com/document/product/1806/130615
TENCENT_WSA_API_KEY=
DASHSCOPE_API_KEY=
GEMINI_API_KEY=

# Protected-site extraction dataset
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=
SCRAPINGBEE_API_KEY=
ZYTE_API_KEY=
ZENROWS_API_KEY=
SCRAPFLY_API_KEY=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
# Private DNS routing for the full WebArena replay. environment.json names these
# variables; Chromium and Kitesurf replay stop with an error while either is empty.
WEBARENA_HOST_OVERRIDE_PATTERN=
WEBARENA_HOST_OVERRIDE_ADDRESS=
# Optional comma-separated hosts through which older WebArena evidence or inputs were
# recorded. Current inputs do not need it. Replay stops with an error on a private
# recorded host that this list omits, and public redaction also covers these hosts.
WEBARENA_RECORDING_GATEWAYS=
# Deployment identity for the full WebArena replay; each app ID is an integer.
WEBARENA_RAINBOND_TEAM=
WEBARENA_ACCEPTANCE_APP_ID=
WEBARENA_SOURCE_APP_ID=
WEBARENA_SHARED_MAP_APP_ID=
WEBARENA_SHARED_WIKIPEDIA_APP_ID=
# Rainbond OpenAPI token used only by the disposable WebArena slice manager.
# Create it in Rainbond: Personal Center -> Access Token.
RAINBOND_API_TOKEN=

# Crawl4AI Cloud: https://crawl4ai.com/dashboard/ (distinct from the local library)
CRAWL4AI_CLOUD_API_KEY=
# Web Search providers. Keep evaluation credentials in this repository file.
LEXMOUNT_SEARCH_API_KEY=
BOCHA_API_KEY=
# Optional dataset publication: https://huggingface.co/settings/tokens (dataset write access).
HF_TOKEN=
# Optional, only for explicitly selected model relevance evaluation.
SEARCH_JUDGE_API_KEY=
SEARCH_JUDGE_BASE_URL=

# Native product extraction: https://app.diffbot.com/get-started/
DIFFBOT_API_TOKEN=
# https://scrapegraphai.com/signup (v2 Extract)
SGAI_API_KEY=
# https://dashboard.oxylabs.io/ (current Web API Bearer authentication)
OXYLABS_API_KEY=

# Comma-separated private hostnames/IPs to omit from extraction report metadata views.
WEB_EXTRACT_PUBLICATION_HOSTS=

# Self-hosted open-source Web Extract service (caller authentication).
EXTRACTION_API_KEY=
EXTRACTION_MAX_WORKERS=1
# Self-hosted deployment (DeepSeek API key acquisition: https://platform.deepseek.com/api_keys)
EXTRACTION_MODEL_API_KEY=
EXTRACTION_MODEL=deepseek-flash
EXTRACTION_MODEL_BASE=https://api.deepseek.com
EXTRACTION_MODEL_CONTEXT_TOKENS=1000000
# Comma-separated exact origins returned by the managed Cloudflare snapshot binding.
SNAPSHOT_ORIGINS=
# Separate, URL-safe passwords for the isolated deployment; generate fresh random hex values.
WEB_EXTRACT_POSTGRES_PASSWORD=
WEB_EXTRACT_QUEUE_PASSWORD=
WEB_EXTRACT_PORT=8080
# Compose supplies CHROME_PATH and the private FIRECRAWL_BACKEND_URL,
# FIRECRAWL_IDENTITY_URL and FIRECRAWL_IMAGE settings.
