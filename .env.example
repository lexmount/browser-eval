# Local implementation checkout
COWAGENT_REPO=
COWAGENT_BENCHMARK_WORKSPACE=~/.browser-eval/runs/cowagent-workspace
OPENCLAW_REPO=
OPENCLAW_NODE=node
DEEPSEEK_HARNESS_REPO=
OSS_PYTHON=python3
# Official Moli CLI; an executable path or a command on PATH. No API key needed.
MOLI_BINARY=moli
LIGHTPANDA_BINARY=lightpanda
OBSCURA_BINARY=obscura
CHROMIUM_BINARY=chromium
KITESURF_CDP_ENDPOINT=wss://kitesurf.cloudflare.app/devtools/browser

# Browser Use optional model-based diagnostics only (not Web Fetch scoring)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional publishing override; default: ~/.config/artifact-hub/token
ARTIFACT_HUB_TOKEN=
# Set explicitly in the environment for both report build and packaging.
WEBFETCH_REPORT_PUBLIC_URL=

# Core benchmark
LEXMOUNT_API_KEY=
LEXMOUNT_PROJECT_ID=
LEXMOUNT_CN_API_KEY=
LEXMOUNT_CN_PROJECT_ID=
FIRECRAWL_API_KEY=

# Known-URL extraction candidates
TAVILY_API_KEY=
EXA_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Query-to-search-results and model-bound retrieval
BOCHA_API_KEY=
QIANFAN_API_KEY=
TENCENT_WSA_API_KEY=
DASHSCOPE_API_KEY=
GEMINI_API_KEY=

# Protected-site scraping dataset
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=
SCRAPINGBEE_API_KEY=
ZYTE_API_KEY=
ZENROWS_API_KEY=
SCRAPFLY_API_KEY=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
