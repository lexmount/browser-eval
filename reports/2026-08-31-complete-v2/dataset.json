{
  "schema_version": 2,
  "id": "public-webfetch-v2.1",
  "name": "Public Web Fetch Ground-truth Dataset",
  "tool": "web_fetch",
  "description": "公开、无需登录的已知 URL→可读正文评测集。每个案例都有冻结的人工核验事实组；不用于宣称反爬绕过能力。",
  "ground_truth": {
    "annotator": "Codex, independently verified against source pages",
    "verified_at": "2026-08-31",
    "policy": "Facts are registered before supplier scoring. Alternatives within a fact group are equivalent. Supplier outputs never define the answer key.",
    "review_status": "single-annotator verified; v2.1 corrected three source-grounded false negatives before final scoring; second-person review recommended before external publication"
  },
  "policy": {
    "login_required": false,
    "anti_bot_targeted": false,
    "content_validation": "Pass requires a prominent marker, minimum length, all required fact groups, and no forbidden error-page marker."
  },
  "cases": [
    {
      "id": "static-simple",
      "name": "Static example page",
      "category": "static_html",
      "url": "https://example.com/",
      "expected_any": [
        "Example Domain"
      ],
      "min_content_chars": 100,
      "required_facts": [
        {
          "id": "title",
          "alternatives": [
            "Example Domain"
          ]
        },
        {
          "id": "purpose",
          "alternatives": [
            "documentation examples",
            "illustrative examples"
          ]
        },
        {
          "id": "iana-link",
          "alternatives": [
            "iana.org/domains/example",
            "More information",
            "Learn more"
          ]
        }
      ],
      "forbidden_any": [
        "Access denied",
        "Attention Required! | Cloudflare",
        "CAPTCHA"
      ],
      "description": "最小静态 HTML 基准。",
      "tags": [
        "html",
        "static"
      ],
      "ground_truth_evidence": [
        {
          "source": "https://example.com/",
          "supports": "标题、用途说明和 IANA 链接"
        }
      ],
      "annotation_notes": "IANA 保留示例域页面，正文稳定。"
    },
