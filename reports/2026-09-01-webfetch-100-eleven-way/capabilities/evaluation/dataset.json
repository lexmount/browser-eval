{
  "schema_version": 1,
  "id": "webfetch-file-media-v2",
  "name": "Web Fetch 文件与媒体能力评测集",
  "tool": "web_fetch",
  "description": "独立于正文主榜，判断方法是抽取文件文字、返回资源链接/元数据，还是下载原始二进制。",
  "ground_truth": {
    "verified_at": "2026-09-01",
    "policy": "文档按正文事实判断；图片和视频不以乱码或二进制转字符串为成功，必须检查资源 URL/元数据或可校验的原始字节。"
  },
  "cases": [
    {
      "id": "direct-pdf",
      "name": "PDF 论文正文",
      "category": "document_pdf",
      "url": "https://arxiv.org/pdf/1706.03762",
      "expected_any": [
        "Attention Is All You Need"
      ],
      "required_facts": [
        {
          "id": "title",
          "alternatives": [
            "Attention Is All You Need"
          ]
        },
        {
          "id": "architecture",
          "alternatives": [
            "Transformer"
          ]
        },
        {
          "id": "attention",
          "alternatives": [
            "Scaled Dot-Product Attention"
          ]
        }
      ],
      "min_content_chars": 1000,
      "task_prompt": "抽取 PDF 的论文正文，不接受只返回下载提示、摘要页链接或原始二进制乱码。",
      "reference_answer": "应包含论文标题 Attention Is All You Need、Transformer 架构和 Scaled Dot-Product Attention 等正文。仅返回可下载 PDF 链接时，只计入文档链接榜，不计入正文榜。",
      "expected_resources": [
        {
          "id": "paper-pdf",
          "kind": "document",
          "urls": [
            "https://arxiv.org/pdf/1706.03762",
            "https://arxiv.org/pdf/1706.03762.pdf"
          ],
          "mime_types": [
            "application/pdf"
          ]
        }
      ]
    },
    {
      "id": "direct-docx",
      "name": "DOCX 文档正文",
      "category": "document_docx",
      "url": "https://calibre-ebook.com/downloads/demos/demo.docx",
      "expected_any": [
        "Demonstration of DOCX support in calibre"
      ],
      "min_content_chars": 500,
      "task_prompt": "抽取公开 DOCX 文件中的可读文字，不接受 ZIP/XML 或二进制乱码。",
      "reference_answer": "正文应出现 Demonstration of DOCX support in calibre，并包含后续格式演示内容。仅返回 DOCX 下载链接时，只计入文档链接榜，不计入正文榜。",
      "expected_resources": [
        {
          "id": "demo-docx",
          "kind": "document",
          "urls": [
            "https://calibre-ebook.com/downloads/demos/demo.docx"
          ],
          "mime_types": [
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
          ]
        }
      ]
    },
    {
      "id": "direct-txt",
      "name": "TXT 纯文本文件",
      "category": "document_txt",
      "url": "https://www.rfc-editor.org/rfc/rfc9110.txt",
      "expected_any": [
        "HTTP Semantics"
      ],
      "min_content_chars": 500,
      "task_prompt": "返回 TXT 文件原始可读文字。",
      "reference_answer": "应包含 RFC 9110 的标题 HTTP Semantics 及规范正文。"
    },
    {
      "id": "direct-image",
      "name": "直接图片 URL",
      "category": "media_image",
      "url": "https://httpbin.org/image/png",
      "expected_any": [],
      "min_content_chars": 0,
      "content_score_applicable": false,
      "task_prompt": "判断接口会下载图片原始字节、返回图片 URL/元数据、进行视觉理解，还是明确拒绝。",
      "reference_answer": "这是 image/png；正文抽取为空是合理结果，但不能把 PNG 二进制解码乱码当作网页正文。"
    },
    {
      "id": "direct-video",
      "name": "直接视频 URL",
      "category": "media_video",
      "url": "https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4",
      "expected_any": [],
      "min_content_chars": 0,
      "content_score_applicable": false,
      "task_prompt": "判断接口会下载视频原始字节、返回视频 URL/元数据、转写视频，还是明确拒绝。",
      "reference_answer": "这是 video/mp4；正文抽取为空是合理结果。除非接口另有多模态能力，否则不能把原始 MP4 当正文。"
    },
    {
      "id": "embedded-image-page",
      "name": "含响应式图片的 HTML 页面",
      "category": "media_embedded_image",
      "url": "https://mdn.github.io/learning-area/html/multimedia-and-embedding/responsive-images/responsive.html",
      "expected_any": [
        "My website"
      ],
      "required_facts": [
        {
          "id": "heading",
          "alternatives": [
            "My website"
          ]
        }
      ],
      "min_content_chars": 200,
      "task_prompt": "抽取页面正文，并检查是否在正文或结构化元数据中返回页面内的图片资源 URL；不要求下载图片二进制。",
      "reference_answer": "正文应包含 My website；资源层应识别两个 img 元素的 Elva 主图地址。CSS 背景图和 srcset 候选不作为必需项。",
      "expected_resources": [
        {
          "id": "elva-main",
          "kind": "image",
          "urls": [
            "elva-800w.jpg"
          ],
          "mime_types": [
            "image/jpeg"
          ]
        },
        {
          "id": "elva-fairy",
          "kind": "image",
          "urls": [
            "elva-fairy-800w.jpg"
          ],
          "mime_types": [
            "image/jpeg"
          ]
        }
      ]
    },
    {
      "id": "embedded-video-page",
      "name": "含两种视频格式的 HTML 页面",
      "category": "media_embedded_video",
      "url": "https://mdn.github.io/learning-area/html/multimedia-and-embedding/video-and-audio-content/multiple-video-formats.html",
      "expected_any": [
        "Multiple format video example"
      ],
      "required_facts": [
        {
          "id": "heading",
          "alternatives": [
            "Below is a video that will play in all modern browsers"
          ]
        }
      ],
      "min_content_chars": 40,
      "task_prompt": "抽取页面可读内容，并检查是否在正文或结构化元数据中返回 MP4 和 WebM 两个资源 URL；不要求下载视频二进制。",
      "reference_answer": "页面标题为 Multiple format video example；资源层必须发现 rabbit320.mp4 和 rabbit320.webm。",
      "expected_resources": [
        {
          "id": "rabbit-mp4",
          "kind": "video",
          "urls": [
            "rabbit320.mp4"
          ],
          "mime_types": [
            "video/mp4"
          ]
        },
        {
          "id": "rabbit-webm",
          "kind": "video",
          "urls": [
            "rabbit320.webm"
          ],
          "mime_types": [
            "video/webm"
          ]
        }
      ]
    },
    {
      "id": "pdf-abstract-page",
      "name": "PDF 对应 HTML 摘要页",
      "category": "web_document_landing",
      "url": "https://arxiv.org/abs/1706.03762",
      "expected_any": [
        "Attention Is All You Need"
      ],
      "required_facts": [
        {
          "id": "title",
          "alternatives": [
            "Attention Is All You Need"
          ]
        },
        {
          "id": "authors",
          "alternatives": [
            "Ashish Vaswani"
          ]
        },
        {
          "id": "abstract",
          "alternatives": [
            "dominant sequence transduction models"
          ]
        }
      ],
      "min_content_chars": 500,
      "task_prompt": "读取论文的 HTML 摘要页，用于区分普通网页读取能力和 PDF 二进制解析能力。",
      "reference_answer": "应返回论文标题、作者和摘要；该案例通过不代表能抽取 PDF 正文。",
      "expected_resources": [
        {
          "id": "paper-pdf-link",
          "kind": "document",
          "urls": [
            "https://arxiv.org/pdf/1706.03762",
            "https://arxiv.org/pdf/1706.03762.pdf"
          ],
          "mime_types": [
            "application/pdf"
          ]
        }
      ]
    }
  ]
}
