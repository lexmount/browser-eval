{
  "schema_version": 1,
  "tracks": {
    "webfetch": {
      "renderer": "harness/web_fetch/report.py",
      "entrypoint": "scripts/build_report.py",
      "profile": "evaluation/current-report.json",
      "example": "https://artifact-site.lexmount.cn/s/p3sFcZrww_nx?version=ver_8ea488f5197c4b57a94c0e7987587e26",
      "example_profile": "evaluation/wcxb/current-report.json",
      "build": "uv run --frozen python scripts/build_report.py --profile evaluation/current-report.json --evidence /absolute/path --output reports/webfetch",
      "check": "make report-check",
      "wcxb_profile": "evaluation/wcxb/current-report.json",
      "wcxb_build": "uv run --frozen python scripts/build_report.py --profile evaluation/wcxb/current-report.json --evidence /absolute/path --output reports/wcxb",
      "wcxb_check": "make wcxb-release-check",
      "wcxb_package": "uv run --frozen python scripts/publish_wcxb_artifact_site.py --package-only --source /absolute/new-report --work /absolute/package",
      "tests": "tests/test_headless_report.py",
      "variants": [
        "certified",
        "wcxb",
        "local-audit",
        "diagnostic-cohorts",
        "published-snapshot-audit"
      ],
      "diagnostic_build": "make webfetch-diagnostic-report DIAGNOSTIC_PROFILE=evaluation/live-webfetch/current-report.json OUTPUT=/absolute/new-output",
      "diagnostic_profile": "evaluation/live-webfetch/current-report.json",
      "diagnostic_check": "uv run --frozen python scripts/check_diagnostic_report.py /absolute/output --profile evaluation/live-webfetch/current-report.json",
      "diagnostic_example": "tests/test_report_templates.py:diagnostic_example",
      "diagnostic_example_check": "uv run --frozen python -m unittest tests.test_report_templates",
      "snapshot_audit_build": "uv run --frozen python scripts/build_report.py --profile /absolute/profile.json --evidence /absolute/published-snapshot --output /absolute/new-report --language zh",
      "snapshot_audit_check": "uv run --frozen python scripts/check_report.py /absolute/new-report --profile /absolute/profile.json",
      "snapshot_audit_tests": "tests/test_published_snapshot_rescoring.py",
      "snapshot_audit_example": "tests/test_published_snapshot_report.py:example",
      "snapshot_audit_example_check": "uv run --frozen python -m pytest tests/test_published_snapshot_report.py tests/test_published_snapshot_rescoring.py",
      "snapshot_audit_release_check": "uv run --frozen python scripts/check_report.py /absolute/new-report --profile /absolute/profile.json --visual-receipt /absolute/private/visual.json",
      "snapshot_audit_package": "uv run --frozen python scripts/package_artifact_hub.py /absolute/new-report /absolute/package.zip --snapshot-audit",
      "snapshot_audit_publish": "uv run --frozen python scripts/publish_artifact_hub.py --create --profile /absolute/publication-target.json --source /absolute/new-report --archive /absolute/package.zip --receipt /absolute/receipt.json --operation-journal /absolute/pending.json --snapshot-audit --visibility private"
    },
    "trajectory-replay": {
      "renderer": "harness/trajectory_replay/webarena_report.py",
      "entrypoint": "scripts/build_webarena_replay_report.py",
      "profile": "evaluation/trajectory-replay/webarena-verified/current-run.json",
      "build": "uv run --frozen python scripts/build_webarena_replay_report.py --profile /absolute/instance-profile.json --results /absolute/results.json --review /absolute/review.json --output /absolute/new-report",
      "check": "uv run --frozen python scripts/check_webarena_replay_report.py /absolute/new-report --profile /absolute/instance-profile.json",
      "tests": "tests/trajectory_replay/test_webarena_report.py",
      "example_profile": "evaluation/trajectory-replay/webarena-verified-full/current-comparison.json",
      "example": "https://artifact-site.lexmount.cn/s/EFLrNgujgsVc?version=ver_c0f0693e9c08401bb4d2b88393234e55",
      "package": "uv run --frozen python scripts/package_webarena_replay_artifact_site.py --report /absolute/new-report --profile /absolute/instance-profile.json --evidence /absolute/results.json --review /absolute/review.json --output /absolute/package.zip --attestation /absolute/attestation.json --visual-receipt /absolute/visual.json"
    },
    "browser-use": {
      "renderer": "harness/browser_use/report.py",
      "entrypoint": "scripts/build_browser_use_report.py",
      "profile": "evaluation/browser-use/current-report.json",
      "build": "uv run --frozen python scripts/build_browser_use_report.py --profile /absolute/instance-profile.json --evidence /absolute/evidence --output /absolute/new-report",
      "check": "uv run --frozen python scripts/check_browser_use_report.py /absolute/new-report --profile /absolute/instance-profile.json --evidence /absolute/evidence --require-complete",
      "tests": "tests/browser_use/test_report.py",
      "package": "uv run --frozen python scripts/package_browser_use_artifact_hub.py --report /absolute/new-report --profile /absolute/instance-profile.json --evidence /absolute/evidence --output /absolute/package.zip --attestation /absolute/attestation.json --visual-receipt /absolute/visual.json"
    }
  }
}
