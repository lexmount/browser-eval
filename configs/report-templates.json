{
  "schema_version": 1,
  "tracks": {
    "webfetch": {
      "renderer": "src/harness/web_fetch/report.py",
      "entrypoint": "scripts/build_report.py",
      "example_env": "WEBFETCH_REPORT_EXAMPLE_URL",
      "example_version": "ver_8ea488f5197c4b57a94c0e7987587e26",
      "build": "uv run --frozen python scripts/build_report.py --profile /absolute/instance-profile.json --evidence /absolute/path --output reports/webfetch",
      "check": "make report-check PROFILE=/absolute/instance-profile.json",
      "wcxb_build": "uv run --frozen python scripts/build_report.py --profile /absolute/instance-profile.json --evidence /absolute/path --output reports/wcxb",
      "wcxb_check": "make wcxb-release-check PROFILE=/absolute/instance-profile.json",
      "wcxb_package": "uv run --frozen python -m harness.web_fetch wcxb-publish --package-only --profile /absolute/instance-profile.json --source /absolute/new-report --work /absolute/package",
      "tests": "tests/test_headless_report.py",
      "variants": [
        "certified",
        "wcxb",
        "local-audit",
        "diagnostic-cohorts",
        "published-snapshot-audit"
      ],
      "diagnostic_build": "make webfetch-diagnostic-report DIAGNOSTIC_PROFILE=/absolute/instance-profile.json OUTPUT=/absolute/new-output",
      "diagnostic_check": "uv run --frozen python -m harness.web_fetch diagnostic-check /absolute/output --profile /absolute/instance-profile.json",
      "diagnostic_example": "tests/test_report_templates.py:diagnostic_example",
      "diagnostic_example_check": "uv run --frozen python -m unittest tests.test_report_templates",
      "snapshot_audit_build": "uv run --frozen python scripts/build_report.py --profile /absolute/profile.json --evidence /absolute/published-snapshot --output /absolute/new-report --language zh",
      "snapshot_audit_check": "uv run --frozen python scripts/check_report.py /absolute/new-report --profile /absolute/profile.json",
      "snapshot_audit_tests": "tests/test_published_snapshot_rescoring.py",
      "snapshot_audit_example": "tests/test_published_snapshot_report.py:example",
      "snapshot_audit_example_check": "uv run --frozen python -m pytest tests/test_published_snapshot_report.py tests/test_published_snapshot_rescoring.py",
      "snapshot_audit_release_check": "uv run --frozen python scripts/check_report.py /absolute/new-report --profile /absolute/profile.json --visual-receipt /absolute/private/visual.json",
      "snapshot_audit_package": "uv run --frozen python -m harness.web_fetch site-package /absolute/new-report /absolute/package.zip --snapshot-audit",
      "snapshot_audit_publish": "uv run --frozen python -m harness.web_fetch site-publish --create --profile /absolute/publication-target.json --source /absolute/new-report --archive /absolute/package.zip --receipt /absolute/receipt.json --operation-journal /absolute/pending.json --snapshot-audit --visibility private"
    },
    "trajectory-replay": {
      "renderer": "src/harness/trajectory_replay/webarena_report.py",
      "entrypoint": "src/harness/trajectory_replay/cli.py",
      "build": "uv run --frozen python -m harness.trajectory_replay report --profile /absolute/instance-profile.json --results /absolute/results.json --review /absolute/review.json --output /absolute/new-report",
      "check": "uv run --frozen python -m harness.trajectory_replay check /absolute/new-report --profile /absolute/instance-profile.json",
      "tests": "tests/trajectory_replay/test_webarena_report.py",
      "example_env": "TRAJECTORY_REPLAY_REPORT_EXAMPLE_URL",
      "example_version": "ver_c0f0693e9c08401bb4d2b88393234e55",
      "package": "uv run --frozen python -m harness.trajectory_replay package --report /absolute/new-report --profile /absolute/instance-profile.json --evidence /absolute/results.json --review /absolute/review.json --output /absolute/package.zip --attestation /absolute/attestation.json --visual-receipt /absolute/visual.json"
    },
    "browser-use": {
      "renderer": "src/harness/browser_use/report.py",
      "entrypoint": "src/harness/browser_use/cli.py",
      "build": "uv run --frozen python -m harness.browser_use report --profile /absolute/instance-profile.json --evidence /absolute/evidence --output /absolute/new-report",
      "check": "uv run --frozen python -m harness.browser_use check /absolute/new-report --profile /absolute/instance-profile.json --evidence /absolute/evidence --require-complete",
      "tests": "tests/browser_use/test_report.py",
      "package": "uv run --frozen python -m harness.browser_use package --report /absolute/new-report --profile /absolute/instance-profile.json --evidence /absolute/evidence --output /absolute/package.zip --attestation /absolute/attestation.json --visual-receipt /absolute/visual.json",
      "example_env": "BROWSER_USE_REPORT_EXAMPLE_URL",
      "example_version": "ver_ce4dd70fde2e444ab18d24bba3ee0e93"
    },
    "web-search": {
      "renderer": "src/harness/web_search/report.py",
      "entrypoint": "src/harness/web_search/cli.py",
      "example": "examples/web_search/README.md",
      "example_version": 1,
      "example_build": "uv run --frozen python -m harness.web_search.example --output /tmp/search-example",
      "build": "uv run --frozen python -m harness.web_search report --profile /absolute/instance/current.json --source /absolute/run --output /absolute/report",
      "check": "uv run --frozen python -m harness.web_search report --output /absolute/report --check",
      "tests": "tests/web_search/test_report.py",
      "variants": [
        "certified-api-comparison",
        "synthetic",
        "combined-cohorts"
      ],
      "release_check": "uv run --frozen python -m harness.web_search report --output /absolute/report --release-check /absolute/visual-receipt.json --publication-plan /absolute/release/publication-plan.json"
    },
    "web-extract": {
      "renderer": "src/harness/web_extract/report.py",
      "entrypoint": "src/harness/web_extract/cli.py",
      "example": "examples/web_extract/README.md",
      "example_version": 1,
      "example_build": "uv run --frozen python -m harness.web_extract.example --output /tmp/scraper-example",
      "build": "uv run --frozen python -m harness.web_extract.cli report --profile /absolute/report-profile.json --content /absolute/content.json --output /absolute/report --language zh",
      "check": "uv run --frozen python -m harness.web_extract.cli check /absolute/report",
      "tests": "tests/web_extract/",
      "variants": [
        "research-and-compatibility",
        "full-cohort-progress",
        "synthetic",
        "field-extraction-cohort"
      ],
      "release_check": "uv run --frozen python -m harness.web_extract.cli check /absolute/report --release --visual-receipt /absolute/visual-receipt.json",
      "package": "uv run --frozen python -m harness.web_extract.cli package /absolute/report --output /absolute/report.zip --visual-receipt /absolute/visual-receipt.json",
      "benchmark": "src/harness/benchmarks/cards/zyte-product-extraction.json",
      "cohort_example_build": "uv run --frozen python -m harness.web_extract.example --output /tmp/scraper-cohort-example --mode full-cohort-progress",
      "publish": "uv run --frozen python -m harness.web_extract.cli publish --source /absolute/report --target /absolute/publication-target.json --work /absolute/new-publication --visual-receipt /absolute/visual-receipt.json",
      "record_example_build": "uv run --frozen python -m harness.web_extract.example --output /tmp/scraper-record-example --mode field-extraction-cohort"
    }
  }
}
