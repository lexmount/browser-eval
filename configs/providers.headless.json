{
  "providers": {
    "kitesurf": {
      "type": "headless_markdown",
      "engine": "kitesurf",
      "account_id": "${CLOUDFLARE_ACCOUNT_ID}",
      "api_token": "${CLOUDFLARE_API_TOKEN}",
      "wait_until": "networkidle2"
    },
    "lightpanda": {
      "type": "headless_markdown",
      "engine": "lightpanda",
      "binary": "${LIGHTPANDA_BINARY:-lightpanda}",
      "resource_binary": "/usr/local/bin/lightpanda"
    },
    "obscura": {
      "type": "headless_markdown",
      "engine": "obscura",
      "binary": "${OBSCURA_BINARY:-obscura}",
      "resource_binary": "/usr/local/bin/obscura"
    },
    "moli-1.0.6": {
      "type": "headless_markdown",
      "engine": "moli",
      "binary": "${MOLI_1_0_6_BINARY:-moli-1.0.6}",
      "expected_version": "1.0.6"
    },
    "moli": {
      "type": "headless_markdown",
      "engine": "moli",
      "binary": "${MOLI_BINARY:-moli}",
      "expected_version": "1.1.5"
    },
    "moli-1.1.7": {
      "type": "headless_markdown",
      "engine": "moli",
      "binary": "${MOLI_1_1_7_BINARY:-moli-1.1.7}",
      "expected_version": "1.1.7"
    },
    "moli-pr643": {
      "type": "headless_markdown",
      "engine": "moli",
      "binary": "${MOLI_PR643_BINARY}"
    },
    "moli-release": {
      "type": "moli_webfetch",
      "engine": "moli",
      "label": "Moli release build",
      "binary": "${MOLI_RELEASE_BINARY}",
      "expected_reported_version": "${MOLI_RELEASE_REPORTED_VERSION}",
      "expected_binary_sha256": "${MOLI_RELEASE_BINARY_SHA256}"
    },
    "moli-candidate": {
      "type": "moli_webfetch",
      "engine": "moli",
      "label": "Moli candidate build",
      "binary": "${MOLI_CANDIDATE_BINARY}",
      "expected_reported_version": "${MOLI_CANDIDATE_REPORTED_VERSION}",
      "expected_binary_sha256": "${MOLI_CANDIDATE_BINARY_SHA256}",
      "release_channel": "candidate"
    },
    "moli-1.1.3": {
      "type": "headless_markdown",
      "engine": "moli",
      "binary": "${MOLI_1_1_3_BINARY:-moli-1.1.3}",
      "expected_version": "1.1.3"
    },
    "chromium": {
      "type": "headless_markdown",
      "engine": "chromium",
      "binary": "${CHROMIUM_BINARY}",
      "resource_binary": "/usr/bin/chromium"
    }
  },
  "default_cohort": "main",
  "resource_cohort": "resources",
  "cohorts": {
    "main": {
      "id": "web-fetch-headless-browsers",
      "name": "浏览器 Web Fetch 对比",
      "providers": [
        "kitesurf",
        "lightpanda",
        "obscura",
        "moli",
        "chromium"
      ]
    },
    "resources": {
      "resource_container_image": "lex-web-fetch-resource:local",
      "id": "web-fetch-headless-resource-profile",
      "name": "本地浏览器 Web Fetch 客户端资源消耗对比",
      "providers": [
        "lightpanda",
        "obscura",
        "moli",
        "chromium"
      ],
      "provider_overrides": {
        "moli": {
          "expected_version": "1.1.1",
          "resource_binary": "/usr/local/bin/moli-1.1.1"
        }
      }
    }
  }
}
