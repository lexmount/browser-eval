          "entry_identity_pattern": "/dp/([A-Z0-9]{10})(?:/|$)",
          "entry_context": "list_or_card",
          "stable_text_anchors": [{"id": "heading", "alternatives": ["Headphones"]}]
        }
      },
      "artifact": "Headphones\n- [Alpha](/alpha/dp/B012345678/ref=one)\n- [Beta](/beta/dp/B087654321/ref=two)",
      "ok": true,
      "expected_task_pass": true,
      "expected_metrics": {"stable_structure_pass": true}
    },
    {
