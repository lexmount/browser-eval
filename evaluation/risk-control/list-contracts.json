              "kind": "date_or_time",
              "aliases": [
                "First edit"
              ]
            },
            {
              "id": "latest_edit",
              "kind": "date_or_time",
              "aliases": [
                "Latest edit"
              ]
            }
          ],
          "fixed_values": {
            "page_id": "1164",
            "wikidata_id": "Q11660"
          }
        },
        {
          "id": "prose-statistics",
          "kind": "field_report",
          "start_pattern": "^(?:#{1,6}\\s*)?Prose\\s*$",
          "end_pattern": "^(?:#{1,6}\\s*)?Registered edits(?:\\s*(?:·|:|[-–—])\\s*.*)?$",
          "required_fields": [
            {
              "id": "prose_words",
              "kind": "integer",
              "aliases": [
                "Words"
              ]
            },
            {
              "id": "references",
              "kind": "integer",
              "aliases": [
                "References"
              ]
            }
          ]
        }
